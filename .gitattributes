# Keep repository text files consistent across Windows development and Linux deployment.
* text=auto eol=lf

# Windows launchers require CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat media and font assets as binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
